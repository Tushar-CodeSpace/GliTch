# GliTch Central Control Plane - Amazon DocumentDB Configuration Template

# 1. AWS DocumentDB Connection String
# Replace user, password, cluster-endpoint, and region with your AWS cluster settings:
# Example: mongodb://glitch_admin:SecurePass123!@docdb-2026-09-15.cluster-xyz.us-east-1.docdb.amazonaws.com:27017/?tls=true&tlsCAFile=global-bundle.pem&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
DOCUMENTDB_URI=mongodb://localhost:27017

# 2. Database Name
DOCUMENTDB_DB_NAME=glitch_db

# 3. AWS RDS Global TLS Certificate Bundle Path
DOCUMENTDB_TLS_CA_FILE=global-bundle.pem

# 4. Enable TLS (Set to true when connecting to Amazon DocumentDB in AWS)
DOCUMENTDB_ENABLE_TLS=false
