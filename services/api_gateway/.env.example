# GliTch Central Control Plane - Local MongoDB Container & Database Configuration

# 1. MongoDB Connection String (Local Container on Port 27017 or Docker Compose network)
MONGODB_URI=mongodb://localhost:27017

# 2. Database Name
MONGODB_DB_NAME=glitch_db

# 3. Enable TLS (Keep false for local Docker container, true for cloud DocumentDB/Atlas with SSL)
MONGODB_ENABLE_TLS=false

# 4. Optional TLS Certificate path (Only needed if MONGODB_ENABLE_TLS=true)
MONGODB_TLS_CA_FILE=global-bundle.pem

