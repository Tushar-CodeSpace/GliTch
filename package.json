{
  "name": "glitch-root",
  "version": "0.1.0",
  "private": true,
  "description": "Glitch - Autonomous AI DevOps Console with Local SQLite Backend",
  "type": "module",
  "scripts": {
    "daemon": "go run ./services/daemon",
    "build:daemon": "go build -o bin/glitch-daemon ./services/daemon",
    "web": "npm --prefix packages/web run dev",
    "build": "npm --prefix packages/web run build && npm run build:daemon",
    "preview": "npm --prefix packages/web run preview",
    "version": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --validate",
    "version:next": "node scripts/version.mjs --next",
    "version:bump": "node scripts/version.mjs --bump",
    "deb": "./scripts/build-deb.sh",
    "test": "npm run test:daemon && npm --prefix packages/web run build",
    "test:daemon": "cd services/daemon && go test -v ./...",
    "db:status": "curl -s http://127.0.0.1:4780/api/db/status || ./bin/glitch-daemon db",
    "db:init": "./bin/glitch-daemon db",
    "start": "go run ./services/daemon"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}

