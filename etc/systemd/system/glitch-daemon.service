[Unit]
Description=Glitch Local DevOps Daemon (Go & SQLite)
Documentation=https://github.com/Tushar-CodeSpace/GliTch
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/glitch
ExecStart=/opt/glitch/bin/glitch-daemon -port 4780 -db /opt/glitch/data/glitch.db -static /opt/glitch/packages/web/dist
Restart=on-failure
RestartSec=5
Environment=GLITCH_PORT=4780
Environment=GLITCH_DB_PATH=/opt/glitch/data/glitch.db

# Sandboxing & Security Hardening
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

